# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=AgriSense AI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local development:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agrisense

# ─── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=app/uploads
MAX_IMAGE_SIZE_MB=10

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── AI Confidence Thresholds ─────────────────────────────────────────────────
# Crop confidence below this value → pipeline rejected (returns 400)
CROP_CONFIDENCE_THRESHOLD=0.40
# Disease confidence below this value → returns "Unknown Disease" (pipeline continues)
DISEASE_CONFIDENCE_THRESHOLD=0.50

# ─── OpenWeatherMap ────────────────────────────────────────────────────────────
# Register at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ─── Market API (Agmarknet / data.gov.in) ─────────────────────────────────────
# Register at https://data.gov.in/
MARKET_API_KEY=your_market_api_key_here
MARKET_API_BASE_URL=https://api.data.gov.in

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=agrisense.log
